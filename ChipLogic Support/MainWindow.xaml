<Window x:Class="ChipLogicSupportApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChipLogic Support Application" Height="450" Width="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Add User Section -->
        <GroupBox Header="Add New User" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Username:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,5,0"/>
                <TextBox x:Name="UsernameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,5,0"/>

                <TextBlock Text="Password:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,10,5,0"/>
                <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,10,5,0"/>

                <Button Content="Add User" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Click="AddUserButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Reset Password Section -->
        <GroupBox Header="Reset User Password" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Select User:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,5,0"/>
                <ComboBox x:Name="ResetUserComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,5,0"/>

                <TextBlock Text="New Password:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,10,5,0"/>
                <PasswordBox x:Name="NewPasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,10,5,0"/>

                <Button Content="Reset Password" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Click="ResetPasswordButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Output Section -->
        <GroupBox Header="Output Log" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid Margin="10">
                <TextBox x:Name="OutputTextBox" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
